@using System.Security.Claims
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - PhishSim</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,400;0,14..32,500;0,14..32,600;0,14..32,700;0,14..32,800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/PhishingSimulator.Web.styles.css" asp-append-version="true" />
</head>
<body>
    <div class="dash-layout">

        <aside class="dash-sidebar">
            <div class="dash-sidebar-inner">

                <a href="/" class="dash-brand">Phish<span>Sim</span></a>

                <nav class="dash-nav">
                    @{
                        var page = ViewContext.RouteData.Values["page"]?.ToString() ?? "";
                    }
                    <a asp-page="/Dashboard/Index" class="dash-nav-item @(page == "/Dashboard/Index" ? "active" : "")">
                        <span class="dash-nav-icon">&#128202;</span> Dashboard
                    </a>
                    <a asp-page="/Family/Index" class="dash-nav-item @(page == "/Family/Index" ? "active" : "")">
                        <span class="dash-nav-icon">&#128106;</span> Family
                    </a>
                    <a asp-page="/Campaigns/Index" class="dash-nav-item @(page.StartsWith("/Campaigns") ? "active" : "")">
                        <span class="dash-nav-icon">&#128233;</span> Campaigns
                    </a>
                    <a asp-page="/Templates/Index" class="dash-nav-item @(page.StartsWith("/Templates") ? "active" : "")">
                        <span class="dash-nav-icon">&#128203;</span> Templates
                    </a>
                    <div class="dash-nav-divider"></div>
                    <a asp-page="/Privacy" class="dash-nav-item">
                        <span class="dash-nav-icon">&#128274;</span> Privacy
                    </a>
                </nav>

                <div class="dash-sidebar-footer">
                    <span class="dash-user-name">@User.Identity?.Name</span>
                    <span class="dash-user-email">@User.FindFirst(ClaimTypes.Email)?.Value</span>
                    <form method="post" asp-page="/Account/Logout" style="margin:0;">
                        <button type="submit" class="btn-signout">Sign out</button>
                    </form>
                </div>

            </div>
        </aside>

        <main class="dash-main">
            @RenderBody()
        </main>

    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
