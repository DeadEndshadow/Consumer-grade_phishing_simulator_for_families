@page
@model IndexModel
@{
    ViewData["Title"] = "Train your family to spot phishing";
}

<!-- Hero -->
<section class="hero">
    <div class="container">
        <div class="hero-inner">
            <div class="hero-badge">Open source &middot; Consent-first</div>
            <h1>Teach your family to<br /><span class="highlight">spot phishing</span></h1>
            <p class="hero-sub">
                Send realistic simulated phishing emails to your loved ones.
                When they click, show them exactly what to look for &mdash; with kindness, not shame.
            </p>
            <div class="hero-actions">
                <a href="#" class="btn-hero-primary">Get started free</a>
                <a href="#how-it-works" class="btn-hero-ghost">How it works &darr;</a>
            </div>
        </div>
    </div>
</section>

<!-- Trust strip -->
<div class="trust-strip">
    <div class="container">
        <div class="trust-items">
            <span class="trust-item"><span class="check">&#10003;</span> Double opt-in consent</span>
            <span class="trust-item"><span class="check">&#10003;</span> No credential capture</span>
            <span class="trust-item"><span class="check">&#10003;</span> GDPR compliant</span>
            <span class="trust-item"><span class="check">&#10003;</span> Opt-out anytime</span>
            <span class="trust-item"><span class="check">&#10003;</span> Self-hostable</span>
        </div>
    </div>
</div>

<!-- How it works -->
<section class="section" id="how-it-works">
    <div class="container">
        <div class="section-header">
            <div class="section-label">How it works</div>
            <h2 class="section-title">Three steps to a safer family</h2>
            <p class="section-subtitle">
                No configuration nightmare. No awkward conversations.
                Just a simple loop that builds real instincts over time.
            </p>
        </div>
        <div class="steps">
            <div class="step">
                <div class="step-number">1</div>
                <h3>Invite your family</h3>
                <p>
                    Enter a family member&rsquo;s name and email. They receive a plain-language
                    invite explaining exactly what will happen. Nothing starts until they confirm.
                </p>
            </div>
            <div class="step">
                <div class="step-number">2</div>
                <h3>They receive a test</h3>
                <p>
                    A realistic simulated phishing email lands in their inbox &mdash; fake parcel,
                    payment alert, or a personal lure. Difficulty scales up over time.
                </p>
            </div>
            <div class="step">
                <div class="step-number">3</div>
                <h3>They learn the red flags</h3>
                <p>
                    Whether they clicked or not, a friendly debrief shows exactly what to look for
                    in that specific email: domain tricks, urgency wording, layout tells.
                </p>
            </div>
        </div>
    </div>
</section>

<!-- Features -->
<section class="section section-alt" id="features">
    <div class="container">
        <div class="section-header">
            <div class="section-label">Features</div>
            <h2 class="section-title">Built for families, not IT teams</h2>
            <p class="section-subtitle">
                Enterprise phishing simulators are too complex and too cold.
                This is designed for people you love.
            </p>
        </div>
        <div class="features-grid">
            <div class="feature-card">
                <div class="feature-icon" style="background: #ede9fe;">&#127917;</div>
                <h3>Realistic templates</h3>
                <p>
                    Hand-crafted lures at Easy, Medium, and Hard difficulty &mdash; parcel
                    delivery, payment failures, and personalised lures that feel real.
                </p>
            </div>
            <div class="feature-card">
                <div class="feature-icon" style="background: #dcfce7;">&#128161;</div>
                <h3>Debrief &amp; reveal page</h3>
                <p>
                    After every click, a friendly page explains the exact red flags in that
                    specific email. This is where the real learning happens.
                </p>
            </div>
            <div class="feature-card">
                <div class="feature-icon" style="background: #dbeafe;">&#128202;</div>
                <h3>Progress dashboard</h3>
                <p>
                    Track clicks, opens, and suspicious-reports per person over time.
                    Watch instincts improve &mdash; and celebrate progress together.
                </p>
            </div>
            <div class="feature-card">
                <div class="feature-icon" style="background: #fef9c3;">&#128274;</div>
                <h3>Privacy by design</h3>
                <p>
                    No real credentials are ever captured. Opt-out links in every email.
                    Consent records stored permanently. GDPR-compliant from day one.
                </p>
            </div>
        </div>
    </div>
</section>

<!-- CTA -->
<section class="cta-section">
    <div class="container">
        <div class="cta-inner">
            <h2>Start protecting your family today</h2>
            <p>Free to use. Self-hostable. No credit card required.</p>
            <a href="#" class="btn-hero-primary">Create your first campaign</a>
        </div>
    </div>
</section>
