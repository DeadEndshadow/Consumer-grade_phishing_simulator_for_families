@page "/campaigns/{id:guid}"
@model PhishingSimulator.Web.Pages.Campaigns.DetailModel
@using PhishingSimulator.Core.Enums
@{
    ViewData["Title"] = Model.Campaign.Name;
    Layout = "~/Pages/Shared/_DashboardLayout.cshtml";
}

<div class="dash-topbar">
    <div>
        <h1>@Model.Campaign.Name</h1>
        <div class="detail-meta" style="margin-top:0.35rem;">
            @{
                var badgeClass = Model.Campaign.Status switch
                {
                    CampaignStatus.Sent      => "badge-sent",
                    CampaignStatus.Scheduled => "badge-scheduled",
                    CampaignStatus.Cancelled => "badge-cancelled",
                    _                        => "badge-draft",
                };
            }
            <span class="badge @badgeClass">@Model.Campaign.Status</span>
            <span>Template: <strong>@Model.Campaign.Template.Name</strong></span>
            <span>Created: <strong>@Model.Campaign.CreatedAt.ToString("MMM d, yyyy")</strong></span>
            <span>Recipients: <strong>@Model.Campaign.Targets.Count</strong></span>
        </div>
    </div>
    <div class="quick-actions">
        <a asp-page="/Campaigns/Index" class="btn-action btn-action-outline">&#8592; Back</a>
        @if (Model.Campaign.Status == CampaignStatus.Draft)
        {
            var confirmedCount = Model.Campaign.Targets.Count(t => t.Participant.ConsentStatus == ConsentStatus.Confirmed);
            <form method="post" asp-page-handler="Send" asp-route-id="@Model.Campaign.Id"
                  onsubmit="return confirm('Send phishing simulation to @confirmedCount confirmed recipient(s)? This cannot be undone.')">
                <button type="submit" class="btn-action btn-action-primary"
                        @(confirmedCount == 0 ? "disabled title=\"No recipients have confirmed consent yet.\"" : "")>
                    &#9993;&nbsp;Send campaign (@confirmedCount ready)
                </button>
            </form>
            <form method="post" asp-page-handler="Delete" asp-route-id="@Model.Campaign.Id"
                  onsubmit="return confirm('Delete this campaign? This cannot be undone.')">
                <button type="submit" class="btn-action" style="background:#fef2f2;color:#b91c1c;border:1px solid #fecaca;">
                    Delete
                </button>
            </form>
        }
    </div>
</div>

<div class="dash-content">
    @if (Model.Campaign.Status == CampaignStatus.Draft)
    {
        var noConsent = Model.Campaign.Targets.Where(t => t.Participant.ConsentStatus != ConsentStatus.Confirmed).ToList();
        @if (noConsent.Any())
        {
            <div class="auth-error" style="margin-bottom:1.25rem;background:#fffbeb;border-color:#fcd34d;color:#92400e;">
                &#9888;&nbsp;<strong>@noConsent.Count recipient(s) have not confirmed consent</strong>
                and will be skipped when you send:
                @string.Join(", ", noConsent.Select(t => t.Participant.Name))
            </div>
        }
    }

    <!-- Template info -->
    <div class="dash-section">
        <div class="dash-section-header">
            <h2 class="dash-section-title">Template: @Model.Campaign.Template.Name</h2>
            @{
                var diffClass = Model.Campaign.Template.Difficulty switch
                {
                    Difficulty.Easy   => "diff-easy",
                    Difficulty.Medium => "diff-medium",
                    _                 => "diff-hard",
                };
            }
            <span class="template-card-diff @diffClass">@Model.Campaign.Template.Difficulty</span>
        </div>
        <div class="dash-section-body">
            <p style="font-size:0.875rem;color:var(--muted);margin:0 0 0.5rem;">
                <strong style="color:var(--text);">Subject line:</strong> @Model.Campaign.Template.SubjectTemplate
            </p>
            <p style="font-size:0.875rem;color:var(--muted);margin:0 0 0.5rem;">
                <strong style="color:var(--text);">Lure type:</strong> @Model.Campaign.Template.LureType
            </p>
            <details style="margin-top:0.75rem;">
                <summary style="font-size:0.82rem;font-weight:600;color:var(--primary);cursor:pointer;">
                    What to look for (shown after click)
                </summary>
                <div style="margin-top:0.75rem;font-size:0.875rem;color:var(--muted);line-height:1.7;
                            background:var(--surface);border-radius:var(--radius-sm);padding:1rem;">
                    @Model.Campaign.Template.WhatToLookFor
                </div>
            </details>
        </div>
    </div>

    <!-- Targets -->
    <div class="dash-section">
        <div class="dash-section-header">
            <h2 class="dash-section-title">Recipients (@Model.Campaign.Targets.Count)</h2>
        </div>

        @if (!Model.Campaign.Targets.Any())
        {
            <div class="empty-state">
                <div class="empty-state-icon">&#128100;</div>
                <h3>No recipients</h3>
                <p>This campaign has no targets.</p>
            </div>
        }
        else
        {
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Email</th>
                        <th>Status</th>
                        <th>Sent</th>
                        <th>Clicked</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var target in Model.Campaign.Targets.OrderBy(t => t.Participant.Name))
                    {
                        var statusClass = target.Status switch
                        {
                            TargetStatus.Clicked   => "badge-cancelled",
                            TargetStatus.Submitted => "badge-cancelled",
                            TargetStatus.Reported  => "badge-sent",
                            TargetStatus.Opened    => "badge-scheduled",
                            TargetStatus.Sent      => "badge-scheduled",
                            _                      => "badge-draft",
                        };
                        var statusLabel = target.Status switch
                        {
                            TargetStatus.Pending   => "Not sent",
                            TargetStatus.Sent      => "Delivered",
                            TargetStatus.Opened    => "Opened",
                            TargetStatus.Clicked   => "Clicked ⚠",
                            TargetStatus.Submitted => "Submitted ‼",
                            TargetStatus.Reported  => "Reported ✓",
                            _                      => target.Status.ToString(),
                        };
                        <tr>
                            <td style="font-weight:600;">@target.Participant.Name</td>
                            <td class="td-muted">@target.Participant.Email</td>
                            <td><span class="badge @statusClass">@statusLabel</span></td>
                            <td class="td-muted">@(target.SentAt?.ToString("MMM d, HH:mm") ?? "—")</td>
                            <td class="td-muted">@(target.ClickedAt?.ToString("MMM d, HH:mm") ?? "—")</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>

</div>
